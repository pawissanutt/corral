+/**
+ * The transcript container: a self-framed tool row drawn directly under another self-framed tool row (nothing
+ * visible between them) drops its blank row, so a run of tool lines reads as one block. Decided while rendering,
+ * so live, resumed and spliced transcripts follow the same rule; default-shell rows keep their spacing.
+ */
+export class TranscriptContainer extends Container {
+    render(width) {
+        const lines = [];
+        const mouseChildren = [];
+        let afterSelfRow = false;
+        for (const child of this.children) {
+            const selfRow = child instanceof ToolExecutionComponent && child.isSelfFramed();
+            if (selfRow)
+                child.setTightTop(afterSelfRow);
+            const childLines = child.render(width);
+            mouseChildren.push({ component: child, height: childLines.length });
+            for (const line of childLines) {
+                lines.push(line);
+            }
+            if (childLines.length > 0)
+                afterSelfRow = selfRow;
+        }
+        this.mouseLayout = { width, children: mouseChildren };
+        return lines;
+    }
