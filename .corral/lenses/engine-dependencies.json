        "path": "crates/corral-engine/Cargo.toml",
        "text": "corral-facts.workspace = true"
      }
    },
    {
      "element": "git",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/Cargo.toml",
        "text": "corral-git.workspace = true"
      }
    },
    {
      "element": "runtime",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/Cargo.toml",
        "text": "name = \"corral-engine\""
      }
    },
    {
      "element": "readers",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/Cargo.toml",
        "text": "corral-facts.workspace = true\ncorral-git.workspace = true"
      }
    },
    {
      "element": "facts-dep",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/Cargo.toml",
        "text": "corral-facts.workspace = true"
      }
    },
    {
      "element": "git-dep",
