        "kind": "text",
        "path": "crates/corral-next/src/main.rs",
        "text": "Command::Done { id, summary }"
      }
    },
    {
      "element": "engine",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/src/review.rs",
        "text": "pub fn done("
      }
    },
    {
      "element": "store",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/src/store.rs",
        "text": "pub fn update_run(&self, run: &Run) -> Result<()>"
      }
    },
    {
      "element": "pipeline",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-engine/src/pipeline.rs",
        "text": "fn kick_pipeline("
      }
    },
    {
      "element": "request",
      "anchor": {
        "kind": "text",
        "path": "crates/corral-next/src/main.rs",
        "text": "apply(&engine, out, Op::Done { id, summary }, false)?"
      }
