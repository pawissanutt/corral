{
  "schema": "corral.repo-diagram",
  "version": 1,
  "id": "submit-work",
  "title": "Submit work: recording a candidate",
  "layout": "ordered_lanes",
  "nodes": [
    {
      "id": "cli",
      "label": "corral-next"
    },
    {
      "id": "engine",
      "label": "Submission engine"
    },
    {
      "id": "store",
      "label": "Task store"
    },
    {
      "id": "pipeline",
      "label": "Review pipeline"
    }
  ],
  "edges": [
    {
      "id": "request",
      "label": "Submit the worker summary",
      "from": "cli",
      "to": "engine"
    },
    {
      "id": "record",
      "label": "Persist the submitted run",
      "from": "engine",
      "to": "store"
    },
    {
      "id": "transition",
      "label": "Move the task to Review",
      "from": "engine",
      "to": "store"
    },
    {
      "id": "advance",
      "label": "Advance after commit",
      "from": "engine",
      "to": "pipeline",
      "note": "Only a new submission advances the pipeline."
    }
  ],
  "evidence": [
    {
