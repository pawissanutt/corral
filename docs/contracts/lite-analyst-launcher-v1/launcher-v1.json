      "lite_source_prefix": "crates/mitimind-vault/seeds/welcome/en/",
      "files": {
        "welcome/18-sample-report-january.md": "53ec3e7417930c558e0cf1d8c50097f4fc537e791fc5f72b2923e7d449518cb2",
